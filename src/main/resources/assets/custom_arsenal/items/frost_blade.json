{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "custom_arsenal:item/frost_blade_gui"
        }
      },
      {
        "when": [
          "ground"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "custom_arsenal:item/frost_blade_ground"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "custom_arsenal:item/frost_blade_3d"
    }
  }
}
